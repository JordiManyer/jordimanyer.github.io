// Cloudflare Workers config: the site is served as static assets from dist/.
{
  "name": "manyer-dev",
  "compatibility_date": "2026-11-17",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
  // Once the old CNAME record for manyer.dev is deleted, uncomment this (and
  // add a comma above) to attach the domain on deploy:
  // "routes": [{ "pattern": "manyer.dev", "custom_domain": true }]
}
